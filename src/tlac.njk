---
pagination:
  data: collections.clanky_vsetky
  size: 1
  alias: c
permalink: "/tlac/{{ c.data.lang }}-{{ c.page.fileSlug }}/index.html"
eleventyExcludeFromCollections: true
---
{# Tlačová verzia článku na A4. Z nej scripts/pdf.py vyrobí PDF a po zostavení sa zmaže. #}{% set L = c.data.lang %}{% set T = i18n[L] %}<!DOCTYPE html>
<html lang="{{ L }}">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>{{ c.data.title }} · {{ site.meno }}</title>
<meta name="author" content="{{ site.meno }}">
<meta name="description" content="{{ c.data.perex }}">
<link rel="stylesheet" href="../../css/tlac.css">
<style>@page { @top-right { content: "{{ T.strana }} " counter(page, decimal-leading-zero) " {{ T.z }} " counter(pages, decimal-leading-zero); } }</style>
</head>
<body>
<header class="titulny">
  <p class="kategoria">{{ c.data.tema | replace(" / ", ", ") }}</p>
  <h1>{{ c.data.title }}</h1>
  <p class="podtitul">{{ c.data.perex | bezBodky }}</p>
  {% if c.data.podujatie or c.data.datum %}<p class="podujatie">{{ c.data.podujatie }}{% if c.data.podujatie and c.data.datum %}, {% endif %}{{ c.data.datum | datum(L) }}</p>{% endif %}
  {% if c.data.doi %}<p class="doi">DOI {{ c.data.doi }}</p>{% endif %}
</header>
{% if c.data.obrazok %}<figure class="obrazok"><img src="../..{{ c.data.obrazok }}" alt=""><figcaption>{{ c.data.popis or T.zastupny }}</figcaption></figure>{% endif %}
<main class="stlpec">
{{ c.content | poznamkyNaStranu | safe }}
</main>
<p class="tiraz">{{ site.url }}{{ c.url }}{% if c.data.doi %} · https://doi.org/{{ c.data.doi }}{% endif %}</p>
</body>
</html>
