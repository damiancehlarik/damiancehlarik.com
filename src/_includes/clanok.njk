---
layout: base.njk
---
{% set T = i18n[lang] %}<article class="clanok">
  <h1>{{ title }}</h1>
  <div class="podtitul caps">{{ tema }}</div>
  <p class="perex">{{ perex }}</p>
  {% if obrazok %}<figure class="hlavny"><img src="{{ obrazok }}" alt="" width="626" height="380"><figcaption>{{ popis or T.zastupny }}</figcaption></figure>{% endif %}
  <div class="telo">
    {{ content | safe }}
  </div>
</article>
