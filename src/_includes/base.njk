{% set T = i18n[lang] %}<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.meno }}</title>
<meta name="description" content="{{ perex or T.predhovor | truncate(160) }}">
<link rel="alternate" hreflang="sk" href="{{ site.url }}{{ page.url | prepnut('sk') }}">
<link rel="alternate" hreflang="en" href="{{ site.url }}{{ page.url | prepnut('en') }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrap">
  <header>
    <a class="logo" href="{{ zaklad }}/">{{ site.meno }}</a>
    <div class="jazyk caps" aria-label="{{ T.jazyk }}">
      <a href="{{ page.url | prepnut('sk') }}" hreflang="sk" lang="sk" {% if lang == "sk" %}class="on" aria-current="true"{% endif %}>SK</a>
      <span aria-hidden="true">/</span>
      <a href="{{ page.url | prepnut('en') }}" hreflang="en" lang="en" {% if lang == "en" %}class="on" aria-current="true"{% endif %}>EN</a>
    </div>
  </header>
  {% if not domov and not bezNavigacie %}{% include "nav.njk" %}{% endif %}
  <main>
    {{ content | safe }}
  </main>
  <footer class="mono">
    <p>{{ T.vaha_1 }} <!--VAHA-->, {{ T.vaha_2 }} <!--CO2--> g CO₂e. <a href="{{ zaklad }}/preco/">{{ T.preco }}</a></p>
    <p>{{ T.kredit }} <a href="{{ zaklad }}/clanky/damian-works/">Damian Works</a></p>
    <p class="kontakt">{% if site.instagram %}<a href="{{ site.instagram }}">{{ T.instagram }}</a>{% else %}<span>{{ T.instagram }}</span>{% endif %}<a href="mailto:{{ site.email }}">{{ T.email }}</a></p>
  </footer>
</div>
</body>
</html>
