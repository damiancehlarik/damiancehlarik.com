{% set T = i18n[lang] %}<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set popis = (perex or T.predhovor) | striptags | truncate(158) %}{% set adresa = site.url + page.url %}{% set obr = site.url + (obrazok or "/img/portret.png") %}<title>{% if title %}{{ title }} · {% endif %}{{ site.meno }}</title>
<meta name="description" content="{{ popis }}">
<meta name="author" content="{{ site.meno }}">
{% if aktivny %}<meta name="robots" content="noindex, follow">{% endif %}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<meta name="theme-color" content="#ffffff">
<link rel="canonical" href="{{ adresa }}">
<link rel="alternate" hreflang="sk" href="{{ site.url }}{{ page.url | prepnut('sk') }}">
<link rel="alternate" hreflang="en" href="{{ site.url }}{{ page.url | prepnut('en') }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url | prepnut('sk') }}">
<meta property="og:type" content="{% if perex and not domov %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ site.meno }}">
<meta property="og:title" content="{{ title or site.meno }}">
<meta property="og:description" content="{{ popis }}">
<meta property="og:url" content="{{ adresa }}">
<meta property="og:image" content="{{ obr }}">
<meta property="og:locale" content="{% if lang == 'en' %}en_GB{% else %}sk_SK{% endif %}">
<meta property="og:locale:alternate" content="{% if lang == 'en' %}sk_SK{% else %}en_GB{% endif %}">
<meta name="twitter:card" content="summary_large_image">
{% if domov or page.url == zaklad + "/info/" %}<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "Person", "name": site.meno, "url": site.url + zaklad + "/", "image": site.url + "/img/portret.png", "jobTitle": ("Designer, curator and educator" if lang == "en" else "Dizajnér, kurátor a pedagóg"), "description": T.predhovor, "email": "mailto:" + site.email, "worksFor": [{ "@type": "Organization", "name": "Damian Works" }, { "@type": "CollegeOrUniversity", "name": "Vysoká škola výtvarných umení v Bratislave", "url": "https://www.vsvu.sk" }], "alumniOf": [{ "@type": "CollegeOrUniversity", "name": "Design Academy Eindhoven" }, { "@type": "CollegeOrUniversity", "name": "Vysoká škola výtvarných umení v Bratislave" }], "address": { "@type": "PostalAddress", "addressLocality": "Bratislava", "addressCountry": "SK" }, "sameAs": [site.orcid, site.society] } | dump | safe }}</script>
{% elif perex %}<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "Article", "headline": title, "description": perex, "inLanguage": lang, "image": obr, "url": adresa, "author": { "@type": "Person", "name": site.meno, "url": site.url + "/" }, "publisher": { "@type": "Organization", "name": "Damian Works" } } | dump | safe }}</script>
{% endif %}<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrap">
  <header>
    <a class="logo" href="{{ zaklad }}/">{{ site.meno }}</a>
    <div class="jazyk caps" aria-label="{{ T.jazyk }}">
      <a href="{{ page.url | prepnut('sk') }}" hreflang="sk" lang="sk" {% if lang == "sk" %}class="on" aria-current="true"{% endif %}>SK</a>
      <span aria-hidden="true">/</span>
      <a href="{{ page.url | prepnut('en') }}" hreflang="en" lang="en" {% if lang == "en" %}class="on" aria-current="true"{% endif %}>EN</a>
    </div>
  </header>
  {% include "nav.njk" %}
  <main>
    {{ content | safe }}
  </main>
  <footer class="mono">
    <p>{{ T.vaha_1 }} <!--VAHA-->, {{ T.vaha_2 }} <!--CO2--> g CO₂e. <a href="{{ zaklad }}/preco/">{{ T.preco }}</a></p>
    <p>{{ T.kredit }} <a href="{{ zaklad }}/clanky/damian-works/">Damian Works</a></p>
    <p class="kontakt">{% if site.instagram %}<a href="{{ site.instagram }}">{{ T.instagram }}</a>{% else %}<span>{{ T.instagram }}</span>{% endif %}<a href="mailto:{{ site.email }}">{{ T.email }}</a></p>
  </footer>
</div>
</body>
</html>
