<!DOCTYPE html>
<html lang="{{ site.jazyk }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.meno }}</title>
<meta name="description" content="{{ perex or site.predhovor | truncate(160) }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrap">
  <header><a class="logo" href="/">{{ site.meno }}</a></header>
  {% if not domov %}{% include "nav.njk" %}{% endif %}
  <main>
    {{ content | safe }}
  </main>
  <footer class="mono">
    <div><h5>STAV</h5><ul><li>Táto stránka: <!--VELKOST--></li><li>Rozpočet: {{ site.rozpocet }} KB</li><li>Obrázky: 1-bit, duotón</li></ul></div>
    <div><h5>ČÍTAŤ</h5><ul><li><a href="/">Články</a></li><li><a href="/tema/damian-works/">Damian Works</a></li></ul></div>
    <div><h5>INFO</h5><ul><li><a href="/o-mne/">O mne</a></li><li><a href="/clanky/preco-je-tento-web-maly/">Kolofón</a></li></ul></div>
    <div><h5>KONTAKT</h5><ul><li>damiancehlarik.com</li><li>Bratislava</li></ul></div>
  </footer>
</div>
</body>
</html>
