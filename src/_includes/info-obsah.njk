{% set T = i18n[lang] %}{% set B = bio[lang] %}{% set clanky = collections["clanky_" + lang] %}
<div class="odkazy">
  <p><a href="mailto:{{ site.email }}">E-mail</a>, {% if site.instagram %}<a href="{{ site.instagram }}">Instagram</a>{% else %}<span>Instagram</span>{% endif %}, <a href="{{ site.orcid }}">ORCID</a></p>
  <p><a href="{{ site.vsvu[lang] }}">{% if lang == "en" %}AFAD{% else %}VŠVU{% endif %}</a>, <a href="{{ site.society }}">Society</a></p>
  <p><a href="{{ zaklad }}/clanky/damian-works/">Damian Works</a>, {% if site.spaceobject %}<a href="{{ site.spaceobject }}">Space Object</a>{% else %}<span>Space Object</span>{% endif %}, {% if site.rcnabytok %}<a href="{{ site.rcnabytok }}">RC Nábytok</a>{% else %}<span>RC Nábytok</span>{% endif %}</p>
</div>
<article class="info">
  <h1 class="skryte">Info</h1>
  <figure class="portret">
    <img src="/img/portret.png" alt="Damián Cehlárik" width="840" height="1052">
    <figcaption>{{ T.foto }}: Ricardo Raspa, {{ T.duoton }}</figcaption>
  </figure>
  <div class="bio">
    <p class="uvod">{{ B.uvod | bio(clanky, zaklad, bio.skratky[lang]) | safe }}</p>
    {% for o in B.odseky %}
    <section>
      <h2>{{ o.nadpis }}</h2>
      <p>{{ o.text | bio(clanky, zaklad, bio.skratky[lang]) | safe }}</p>
    </section>
    {% endfor %}
  </div>
  <section class="cv">
    <h2>{{ T.vyber }}</h2>
    {% for k in cv[lang] %}
    <details>
      <summary>{{ k }}</summary>
      {% set pol = cv.polozky[k] %}{% if pol and pol.length %}<ul>{% for p in pol %}<li><span class="rok">{{ p.rok }}</span> <span>{{ p.text | bio(clanky, zaklad, {}) | safe }}</span></li>{% endfor %}</ul>{% else %}<p class="pripravuje">{{ T.pripravuje }}</p>{% endif %}
    </details>
    {% endfor %}
  </section>
</article>
