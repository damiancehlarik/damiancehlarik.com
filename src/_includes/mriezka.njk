<ul class="mriezka">
{% for p in zoznam %}
  <li class="karta"><a href="{{ p.url }}">
    {% if p.data.obrazok %}<img src="{{ p.data.obrazok | nahlad }}" alt="" loading="lazy">{% endif %}
    <div class="tema caps">{{ p.data.tema }}</div>
    <h2>{{ p.data.title }}</h2>
    <p>{{ p.data.perex }}</p>
    <div class="datum">{{ p.date | rok }}</div>
  </a></li>
{% endfor %}
</ul>
