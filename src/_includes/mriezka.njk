{% set T = i18n[lang] %}{% if zoznam | length %}<table class="index">
  <thead><tr><th class="c">{{ T.c }}</th><th>{{ T.titul }}</th><th class="an">{{ T.anotacia }}</th><th class="kat">{{ T.kategoria }}</th></tr></thead>
  <tbody>
{% for p in zoznam | reverse %}    <tr><td class="c">{{ (p.data.poradie or loop.revindex) | dvojmiestne }}</td><td class="t"><a href="{{ p.url }}">{{ p.data.title }}</a></td><td class="an">{{ p.data.perex }}</td><td class="kat"><em>{{ p.data.tema | replace(" / ", ", ") }}</em></td></tr>
{% endfor %}  </tbody>
</table>{% else %}<p class="prazdne">{{ T.prazdne }}</p>{% endif %}
