---
layout: base.njk
title: Info
bezNavigacie: true
permalink: /en/info/
---
{% set T = i18n[lang] %}{% set B = bio[lang] %}{% set clanky = collections["clanky_" + lang] %}
<div class="odkazy caps">
  <div class="rad kontakt">
    <a href="mailto:{{ site.email }}">E-mail</a>
    {% if site.instagram %}<a href="{{ site.instagram }}">Instagram</a>{% else %}<span>Instagram</span>{% endif %}
    <a href="{{ site.orcid }}">ORCID</a>
  </div>
  <div class="rad">
    <a href="{{ site.vsvu[lang] }}">{% if lang == "en" %}AFAD{% else %}VŠVU{% endif %}</a>
    <a href="{{ site.society }}">Society</a>
  </div>
  <div class="rad">
    <a href="{{ zaklad }}/clanky/damian-works/">Damian Works</a>
    {% if site.spaceobject %}<a href="{{ site.spaceobject }}">Space Object</a>{% else %}<span>Space Object</span>{% endif %}
    {% if site.rcnabytok %}<a href="{{ site.rcnabytok }}">RC Nábytok</a>{% else %}<span>RC Nábytok</span>{% endif %}
  </div>
</div>
<article class="info">
  <h1>Info</h1>
  <figure class="portret">
    <img src="/img/portret.png" alt="Damián Cehlárik" width="840" height="1052">
    <figcaption>{{ T.foto }}: Ricardo Raspa</figcaption>
  </figure>
  <div class="bio">
    <p class="uvod">{{ B.uvod | bio(clanky, zaklad, bio.skratky[lang]) | safe }}</p>
    {% for o in B.odseky %}
    <section>
      <h2 class="caps">{{ o.nadpis }}</h2>
      <p>{{ o.text | bio(clanky, zaklad, bio.skratky[lang]) | safe }}</p>
    </section>
    {% endfor %}
  </div>
  <section class="cv">
    <h2 class="caps">{{ T.vyber }}</h2>
    {% for k in cv[lang] %}
    <details>
      <summary>{{ k }}</summary>
      {% set pol = cv.polozky[k] %}{% if pol and pol.length %}<ul>{% for p in pol %}<li><span class="rok">{{ p.rok }}</span> {{ p.text | bio(clanky, zaklad, {}) | safe }}</li>{% endfor %}</ul>{% else %}<p class="pripravuje">{{ T.pripravuje }}</p>{% endif %}
    </details>
    {% endfor %}
  </section>
</article>
